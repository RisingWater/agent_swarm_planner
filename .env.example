# agent_swarm 平台地址（默认 http://127.0.0.1:8700）
AGENT_SWARM_SERVER=http://127.0.0.1:8700
# 账号 API Key（账号页可复制）；留空则尝试读取 ~/.config/opencode/agent-swarm.json
AGENT_SWARM_API_KEY=
# planner 工作区 ID；留空则读取 .agent_swarm/workspace.md 的 WORKSPACE_ID 行
PLANNER_WORKSPACE_ID=
# 注入提示词时使用的 caller 名称（显示在平台调用记录里）
PLANNER_CALLER=planner-core
# SQLite 路径；留空默认 <项目根>/data/planner.db
PLANNER_DB=
# 调度/注入参数
PLANNER_NUDGE_MIN_INTERVAL=60
PLANNER_MAX_RETRY=3
# 注入提示词的第 0 步（默认要求 agent 先压缩上下文再干活）
PLANNER_FIRST_STEP=先压缩/总结你自己的上下文（如 opencode 的 /compact），释放上下文窗口后再开始。
# 阻塞等待 planner agent 完成的秒数（message/send 网关最长 1h）
PLANNER_SEND_TIMEOUT=600
